<Project Sdk="Godot.NET.Sdk/4.8.0-beta.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <UseAppLocalIcu>false</UseAppLocalIcu>
  </PropertyGroup>
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <Import Project="../MsbuildProps/AutoDetactPlatformDefines.props"/>
  <Import Project="../MsbuildProps/DetectWindowsVlcNatives.props" Condition="$(Windows)"/>
  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" Condition="$(Desktop)" />
    <PackageReference Include="LiteNetLib" Version="2.0.2" />
    <!-- libvlc natives for the desktop video backend. The Windows package drops libvlc/win-x64 next to
         the assemblies; Linux has no package, so tools/libvlc_linux.py builds the bundle below. -xlinka -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" Condition="$(Desktop)" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="$(Windows)" />
  </ItemGroup>
  <!-- The Linux libvlc bundle (python tools/libvlc_linux.py) rides in data_*/libvlc/linux-x64. Players
       on SteamOS, the Frame and most distros have no libvlc to fall back on, so a Linux export without
       it plays nothing but Theora. -xlinka -->
  <ItemGroup Condition="$(Linux) And Exists('..\.natives\libvlc-linux-x64\lib\libvlc.so.5')">
    <None Include="..\.natives\libvlc-linux-x64\**" LinkBase="libvlc\linux-x64" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LumoraCore\LumoraCore.csproj" />
    <ProjectReference Include="..\LumoraHooks\LumoraHooks.csproj" />
    <ProjectReference Include="..\LumoraFluidsHooks\LumoraFluidsHooks.csproj" />
  </ItemGroup>
  <!-- Garbage collection for a game. Past nine tenths of the machine's memory in use (the game, the browser,
       everything else open) the runtime switched to full collections that stop every thread to compact, and with
       a crowd in each was a 400 to 600 ms frame. It waits for the last few percent now. Workstation and concurrent are the defaults, spelled out so a later
       setting elsewhere cannot flip them. -xlinka -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HighMemoryPercent" Value="95" />
  </ItemGroup>
  <!-- Desktop exports ship their code precompiled. Compiled on first call instead, the first open of
       anything in a session cost two to four times its later opens: measured headless, the shader gallery's
       first build took 974 ms against 480 ms precompiled, and the scratch space's worst first frame 175 ms
       against 87 ms. Hot code is still recompiled at full optimisation later, so steady state is the same.
       Only applies to publish, so editor builds are untouched; Android exports run on Mono and are left
       alone. -xlinka -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And ($(RuntimeIdentifier.StartsWith('win-')) Or $(RuntimeIdentifier.StartsWith('linux-'))) And !$(RuntimeIdentifier.Contains('bionic'))">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <!-- for steam rt 4 builds -->
  <!-- run with env vars UseAppLocalIcu=true IcuVersion="72.1.0.3" replace with current version -->
  <ItemGroup Condition="$(Linux) And $(UseAppLocalIcu) And '$(IcuVersion)' != ''">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="$(IcuVersion)" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(IcuVersion)" />
  </ItemGroup>
  <!-- Copy LumoraCore.dll to addons folder after build -->
  <Target Name="CopyLumoraCoreToAddons" AfterTargets="Build">
    <MakeDir Directories="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraCore.dll" DestinationFolder="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraCore.pdb" DestinationFolder="$(ProjectDir)addons\lumora\bin" Condition="Exists('$(OutputPath)LumoraCore.pdb')" />
  </Target>

  <!-- Copy LumoraHooks.dll to addons folder after build -->
  <Target Name="CopyLumoraHooksToAddons" AfterTargets="Build">
    <MakeDir Directories="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraHooks.dll" DestinationFolder="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraHooks.pdb" DestinationFolder="$(ProjectDir)addons\lumora\bin" Condition="Exists('$(OutputPath)LumoraHooks.pdb')" />
  </Target>

  <!-- Copy LumoraMath.dll to addons folder after build -->
  <Target Name="CopyLumoraMathToAddons" AfterTargets="Build">
    <MakeDir Directories="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraMath.dll" DestinationFolder="$(ProjectDir)addons\lumora\bin" />
    <Copy SourceFiles="$(OutputPath)LumoraMath.pdb" DestinationFolder="$(ProjectDir)addons\lumora\bin" Condition="Exists('$(OutputPath)LumoraMath.pdb')" />
  </Target>

  <!-- The Steam native redistributables ride the build AND the publish output: an export copies the publish
       output into its data folder, where the runtime looks for them. Copied only on build, every export
       shipped without them and Steam never started outside the editor. -->
  <ItemGroup Condition="$(Linux)">
    <None Remove="steam_api64.dll;libsteam_api.so" />
    <None Include="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('steam_api64.dll') And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win')))" />
    <None Include="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('libsteam_api.so') And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('linux')))" />
  </ItemGroup>
</Project>
