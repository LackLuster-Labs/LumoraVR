[input_devices]

pointing/emulate_mouse_from_touch.android_phone=false

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Props"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.003
jolt_physics_3d/simulation/speculative_contact_distance=0.02
jolt_physics_3d/limits/temporary_memory_buffer_size=64
jolt_physics_3d/limits/max_linear_velocity=8.0
jolt_physics_3d/limits/max_angular_velocity=16.0
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=262144
jolt_physics_3d/limits/max_contact_constraints=131072
jolt_physics_3d/limits/temporary_memory_buffer_size.android=32
#TheenginewriteseveryNode3Dtransformonceperrenderframefromtheengine#updateinLumoraEngineRunner._Process(input->worldupdate->SlotHookflush->#camerapositioning,allbeforetheframerenders).Godot'sphysicsinterpolation#assumestransformsonlychangeonthefixedphysicstick,soitsmearsevery#engine-drivennodebetweenstaleticksnapshotswhilethecamera(whichoptsout)#stayscrisp--thatmismatchiswhatmadehands,heldobjects,theavatar,andthe#contextmenujitterwhilemovingeventhoughtheyarerigidchildrenoftheuser#root.Per-render-frametransformwritesandinterpolationaremutuallyexclusive#wedrivetransformseveryframe,sotheinterpolationlayerstaysoff.common/physics_interpolation=false

[rendering]

rendering_device/staging_buffer/block_size_kb=1024
rendering_device/staging_buffer/texture_upload_region_size_px=256
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
reflections/reflection_atlas/reflection_count=256
reflections/reflection_atlas/reflection_size=128
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/use_debanding=true
mesh_lod/lod_change/threshold_pixels=2.0
renderer/rendering_method.android="mobile"
renderer/rendering_method.steam_frame="mobile"

[xr]

openxr/enabled=true
openxr/foveation_eye_tracked=false
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/eye_gaze_interaction=true
shaders/enabled=true
openxr/enabled.android_phone=false
shaders/enabled.android_phone=false
openxr/action_map="res://openxr_action_map.tres"
