; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LumoraVR"
run/main_scene="uid://c8sly288nngj4"
config/use_custom_user_dir=true
config/custom_user_dir_name="LumoraVR"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://Assets/Textures/lumoravricon.svg"

[audio]

driver/enable_input=true
driver/mix_rate=48000

[autoload]

PathResolverSetup="*uid://c8ohgparu466q"

[debug_draw_3d]

settings/3d/volumetric_defaults/thickness=0.0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode="enabled"
window/size/always_on_top.editor=false
window/handheld/orientation.android_phone=4

[dotnet]

project/assembly_name="Lumora"

[editor]

run/main_run_args="--steam"

[editor_plugins]

enabled=PackedStringArray("res://addons/action_map_guard/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

