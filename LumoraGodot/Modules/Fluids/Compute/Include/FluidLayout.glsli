struct FluidSummaryHeader
{
    uint frame;
    uint flags;
    uint awake;
    uint live;
    uint contacts;
    uint limbs;
    uint bakes;
    uint pending;
    uint impulses;
    uint volumes;
    uint systems;
    uint queries;
    uint props;
    uint bins;
    uint binCursor;
    uint binTotal;
    float vmax;
    float kineticEnergy;
    uint nanCount;
    uint overflow;
    uint neighbourOverflow;
    uint slabOverflow;
    uint poolEmpty;
    uint reserved0;
    uint submittedSequence;
    uint spare[7];
};
#define FLUID_SUMMARY_HEADER_SIZE 128

