// The fluid GPU layouts, std430, byte for byte the structs in LumoraFluids/Source/Gpu/Layout/. Every kernel
// includes this first: Godot pastes an include in as text and does not follow an include inside it, so
// FluidKernels.glsli and FluidThinning.glsli are included after it, never from it. Buffers and bindings are
// declared by each kernel. -xlinka

#ifndef FLUID_LAYOUT_GLSLI
#define FLUID_LAYOUT_GLSLI

#define FLUID_GROUP_SIZE 64  // workgroup width of every particle kernel
#define FLUID_MAX_NEIGHBOURS 96  // neighbour list cap, h + skin
#define FLUID_NONE 0xFFFFFFFFu  // empty index or id
#define FLUID_NANOLITRES_PER_CUBIC_METRE 1e12  // the accumulators' fixed point
#define FLUID_MAX_SUBSTANCES 16
#define FLUID_MAX_COLLIDERS 512
#define FLUID_MAX_IMPULSE_BODIES 256
#define FLUID_MAX_FORCES 32  // FluidForceRecords a frame (est.)
#define FLUID_BODY_PARTS 16
#define FLUID_LIMBS 4
#define FLUID_PHASE_MASK 15u
#define FLUID_PHASE_BULK 0u
#define FLUID_PHASE_STRAND 1u
#define FLUID_PHASE_DROP 2u
#define FLUID_PHASE_SPRAY 3u
#define FLUID_PHASE_DEAD 15u  // a free slot
#define FLUID_PARTICLE_ASLEEP 16u
#define FLUID_PARTICLE_ANCHORED 32u
#define FLUID_PARTICLE_FADING 64u
#define FLUID_PARTICLE_NEW 128u
#define FLUID_NEIGHBOUR_COUNT_SHIFT 8  // 8 bits
#define FLUID_CHAIN_BOND_SHIFT 16  // 2 bits
#define FLUID_SUBSTANCE_SHIFT 0
#define FLUID_SYSTEM_SHIFT 8
#define FLUID_FRAME_SHIFT 16
#define FLUID_ORIGIN_SHIFT 24
#define FLUID_BYTE_MASK 255u
#define FLUID_ANCHOR_KIND_MASK 15u
#define FLUID_ANCHOR_AGE_SHIFT 8
#define FLUID_ANCHOR_NONE 0u
#define FLUID_ANCHOR_STATIC 1u
#define FLUID_ANCHOR_RIGID 2u
#define FLUID_ANCHOR_BONE 3u
#define FLUID_ANCHOR_SKIN 4u
#define FLUID_COLLIDER_BOX 0u
#define FLUID_COLLIDER_SPHERE 1u
#define FLUID_COLLIDER_CAPSULE 2u
#define FLUID_COLLIDER_CYLINDER 3u
#define FLUID_COLLIDER_CONVEX 4u
#define FLUID_COLLIDER_MESH 5u
#define FLUID_PROXY_CAPSULE 0u
#define FLUID_PROXY_BOX 1u
#define FLUID_PROXY_SPHERE 2u
#define FLUID_PERSON_STICK_MASK 3u  // FluidStickMode
#define FLUID_PERSON_LOD_SHIFT 2  // 3 bits, view LOD
#define FLUID_PERSON_LOCAL 32u
#define FLUID_PERSON_VIEW_ONLY 64u
#define FLUID_PERSON_FROZEN 128u  // Hidden or StandIn: anchors freeze
#define FLUID_PERSON_DROP_ANCHORS 0x100u  // teleport, avatar swap
#define FLUID_CONTACT_BONE_MASK 0xFFFFu  // FluidContactVertex.BoneN: the bone, relative to its person
#define FLUID_CONTACT_PART_SHIFT 16  // FluidContactVertex.Bone0 bits 16-23: the vertex's FluidBodyParts index
#define FLUID_SKIN_BONE_FIRST 16u  // a person's relative bones count the part bones first, so skin bones start here
#define FLUID_CONTACT_SUBSTANCE_SHIFT 8  // FluidContactRecord.Part bits 8-15: the deepest contact's frame substance
#define FLUID_CONTACT_FLAG_SHIFT 24  // FluidContactVertex.Bone0 bits 24-31: the vertex's surface flags
#define FLUID_CONTACT_TWO_SIDED 0x1000000u  // Bone0 flag: an open surface (a hair card, a hem), collided from the side the fluid came from
#define FLUID_FRAME_KEEPER 1u  // this machine keeps at least one system here
#define FLUID_FRAME_BAKES 2u  // bake candidates are collected this frame
#define FLUID_FRAME_FOCUSED 4u
#define FLUID_FRAME_BACKGROUND 8u
#define FLUID_FRAME_FIRST_OF_BLOCK 16u  // uploads and commands apply; clear on a repeated sub-frame of one block
#define FLUID_FRAME_BIN 32u  // the keeper bins into the ledger
#define FLUID_FRAME_RECONCILE 64u  // a machine that does not keep compares its particles with the ledger
#define FLUID_FRAME_LITE 128u
#define FLUID_FRAME_WATER_ONE_ITERATION 0x100u
#define FLUID_FRAME_REMOTE_REFINE_OFF 0x200u
#define FLUID_FRAME_HALF_RATE_BRICKS 0x400u
#define FLUID_FRAME_NO_SURFACE 0x800u
#define FLUID_FRAME_COMMANDS_ONLY 0x1000u  // a paused world: apply the commands, run no substep
#define FLUID_SYSTEM_KEPT 1u
#define FLUID_SYSTEM_PAUSED 2u
#define FLUID_SYSTEM_CONTAINER 4u
#define FLUID_SYSTEM_STICK_TO_PEOPLE 8u
#define FLUID_SYSTEM_PUSH_BODIES 16u
#define FLUID_SYSTEM_MIX_COLOURS 32u
#define FLUID_SYSTEM_COLLIDE_WITH_WORLD 64u
#define FLUID_FRAME_RECORD_CONTAINER 1u  // a container's frame; Container holds its index
#define FLUID_COLLIDER_DYNAMIC 1u  // under a rigid body: pushed back through the impulse table
#define FLUID_COLLIDER_TRIGGER 2u
#define FLUID_COLLIDER_MOVED 4u  // moved more than a millimetre since last frame
#define FLUID_COLLIDER_DRAIN 8u
#define FLUID_COLLIDER_NO_STICK 16u  // fluid touches it and never anchors to it
#define FLUID_FORCE_DIRECTIONAL 0u
#define FLUID_FORCE_RADIAL 1u
#define FLUID_FORCE_VORTEX 2u
#define FLUID_FORCE_DRAG 3u
#define FLUID_SUMMARY_ALL_ASLEEP 1u
#define FLUID_SUMMARY_POOL_EMPTY 2u
#define FLUID_SUMMARY_NAN_RESET 4u
#define FLUID_SUMMARY_ENERGY_RISE 8u

// FluidGpuOp
#define FLUID_OP_NONE 0u
#define FLUID_OP_EMIT 1u
#define FLUID_OP_BURST 2u
#define FLUID_OP_REMOVE 3u
#define FLUID_OP_CLEAR_ALL 4u
#define FLUID_OP_CLEAR_ORIGIN 5u
#define FLUID_OP_EVAPORATE 6u
#define FLUID_OP_FADE_ORIGIN 7u
#define FLUID_OP_SETTLE 8u
#define FLUID_OP_RELEASE 9u
#define FLUID_OP_REMOVE_PARTICLES 10u
#define FLUID_OP_RESEED 11u
#define FLUID_OP_WAKE_BOX 12u
#define FLUID_OP_DROP_ANCHORS 13u
#define FLUID_OP_FREEZE_ANCHORS 14u
#define FLUID_OP_ZERO_VELOCITY 15u
#define FLUID_OP_REMOVE_BOX 16u

#define FLUID_SUMMARY_CONTACTS_CAPACITY 64
#define FLUID_SUMMARY_CONTACTS_OFFSET 128
#define FLUID_SUMMARY_LIMBS_CAPACITY 32
#define FLUID_SUMMARY_LIMBS_OFFSET 1152
#define FLUID_SUMMARY_BAKES_CAPACITY 32
#define FLUID_SUMMARY_BAKES_OFFSET 2176
#define FLUID_SUMMARY_PENDING_CAPACITY 64
#define FLUID_SUMMARY_PENDING_OFFSET 3200
#define FLUID_SUMMARY_IMPULSES_CAPACITY 32
#define FLUID_SUMMARY_IMPULSES_OFFSET 4224
#define FLUID_SUMMARY_VOLUMES_CAPACITY 16
#define FLUID_SUMMARY_VOLUMES_OFFSET 5248
#define FLUID_SUMMARY_SYSTEMS_CAPACITY 16
#define FLUID_SUMMARY_SYSTEMS_OFFSET 5504
#define FLUID_SUMMARY_QUERIES_CAPACITY 128
#define FLUID_SUMMARY_QUERIES_OFFSET 6528
#define FLUID_SUMMARY_PROPS_CAPACITY 32
#define FLUID_SUMMARY_PROPS_OFFSET 8576
#define FLUID_SUMMARY_BINS_CAPACITY 192
#define FLUID_SUMMARY_BINS_OFFSET 9600
#define FLUID_SUMMARY_BYTES 15744

// The summary buffer's members in order; std430 puts each section at its FLUID_SUMMARY_*_OFFSET:
// layout(set = 0, binding = N, std430) buffer FluidSummaryBuffer { FLUID_SUMMARY_MEMBERS } summary;
#define FLUID_SUMMARY_MEMBERS \
    FluidSummaryHeader header; \
    FluidContactRecord contacts[64]; \
    FluidLimbRecord limbs[32]; \
    FluidBakeCandidate bakes[32]; \
    FluidPendingRemote pending[64]; \
    FluidImpulseRecord impulses[32]; \
    FluidVolumeRecord volumes[16]; \
    FluidSystemStatus systems[16]; \
    FluidQueryResult queries[128]; \
    FluidPropEvent props[32]; \
    FluidLedgerEntry bins[192];

struct FluidParticle
{
    vec3 position;
    float volume;
    vec3 previous;
    float mass;
    vec3 velocity;
    float wetness;
    uint phase;
    uint material;
    uint tint;
    uint region;
    float age;
    float bandTime;
    float fadeTime;
    uint reserved1;
};
#define FLUID_PARTICLE_SIZE 80

struct FluidBond
{
    uint partner;
    float restLength;
    float radius;
    uint strainFlags;
    float lambda;
};
#define FLUID_BOND_SIZE 20

struct FluidAccumulator
{
    int volumeNl;
    uint label;
    uint strandAge;
    uint claim;
};
#define FLUID_ACCUMULATOR_SIZE 16

struct FluidAnchor
{
    uint kindAge;
    uint target;
    uint triangle;
    uint normal;
    vec3 point;
    float strength;
};
#define FLUID_ANCHOR_SIZE 32

struct FluidGridCell
{
    uint start;
    uint count;
};
#define FLUID_GRID_CELL_SIZE 8

struct FluidFrameRecord
{
    vec4 rotation;
    vec3 position;
    float scale;
    vec4 lastRotation;
    vec3 lastPosition;
    float lastScale;
    vec3 linearAcceleration;
    uint system;
    vec3 angularVelocity;
    uint flags;
    vec3 angularAcceleration;
    uint container;
    uint reserved1;
    uint reserved2;
    uint reserved3;
    uint reserved4;
};
#define FLUID_FRAME_RECORD_SIZE 128

struct FluidRegion
{
    uint awake;
    uint maxSpeedBits;
    uint particles;
    uint quietFrames;
};
#define FLUID_REGION_SIZE 16

struct FluidSubstanceRecord
{
    float spacing;
    float smoothingRadius;
    float restDensity;
    float particleMass;
    float density;
    float viscosity;
    float xsphFactor;
    float flowIndex;
    float yieldStrain;
    float bondCompliance;
    float creepTime;
    float relaxation;
    float stretchLimit;
    float minThread;
    float surfaceTension;
    float cohesion;
    float adhesion;
    float anchorStrength;
    float anchorCompliance;
    float stickDistance;
    float stickTime;
    float friction;
    float dryTime;
    float cureTime;
    float washability;
    float colorMixing;
    float maxSpeed;
    float sCorrK;
    float sCorrN;
    float sCorrDq;
    float nearRepulsion;
    float bendCompliance;
    float sleepSpeed;
    float bondRadius;
    uint tint;
    uint flags;
