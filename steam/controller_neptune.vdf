"controller_mappings"
{
	"version"		"3"
	"revision"		"1"
	"title"		"Lumora (Steam Deck)"
	"description"		"Lumora's own layout. Left stick walks, right stick looks, gyro adds fine aim, right trackpad is the mouse and its click a left click. A jump, B crouch and back, X hold a carried object to turn it, Y radial menu. R2 use, L2 grab, R1 tool secondary, L1 blink aim and resize. L3 run, R3 hop back. Menu opens the dash, View the chat. Back grips: L4 third person, L5 free camera, R4 the same as X, R5 photo."
	"progenitor"		"template://controller_neptune_gamepad_mouse_gyro.vdf"
	"controller_type"		"controller_neptune"
	"controller_caps"		"23117823"
